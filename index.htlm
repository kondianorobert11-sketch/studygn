<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyGN - Plateforme de Révision Universitaire</title>
    <!-- Tailwind CSS pour un design moderne et rapide -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 500: '#6366f1', 600: '#4f46e5' }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col transition-colors duration-200">

    <!-- En-tête -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50">
        <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <span class="bg-brand-500 text-white font-bold p-2 rounded-lg text-lg">S-GN</span>
                <h1 class="text-xl font-bold tracking-tight">StudyGN <span class="text-xs bg-slate-700 px-2 py-1 rounded text-brand-400">Uni</span></h1>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-xs text-slate-400 hidden sm:inline">Communication & Journalisme</span>
            </div>
        </div>
    </header>

    <!-- Contenu Principal -->
    <main class="flex-grow max-w-5xl mx-auto px-4 py-6 w-full">
        
        <!-- Section Bannière -->
        <section class="bg-gradient-to-r from-indigo-900 to-slate-800 rounded-2xl p-6 mb-8 border border-slate-700 shadow-lg">
            <h2 class="text-2xl font-extrabold mb-2 text-white">Espace de révision universitaire</h2>
            <p class="text-slate-300 text-sm max-w-2xl mb-4">
                Accédez à vos fiches de cours, méthodologies et quiz pour réussir vos examens en Communication et Journalisme.
            </p>
            <!-- Barre de recherche -->
            <div class="relative">
                <input type="text" id="searchInput" placeholder="Rechercher un cours, une notion (ex: Interview, Droit...)" 
                    class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-brand-500">
            </div>
        </section>

        <!-- Filtres par matière -->
        <div class="flex flex-wrap gap-2 mb-6" id="categoryFilters">
            <button onclick="filterCourses('all')" class="px-4 py-2 text-xs font-semibold rounded-lg bg-brand-600 text-white transition">Tout voir</button>
            <button onclick="filterCourses('communication')" class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition">Communication</button>
            <button onclick="filterCourses('journalisme')" class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition">Journalisme</button>
            <button onclick="filterCourses('methodo')" class="px-4 py-2 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition">Méthodologie</button>
        </div>

        <!-- Liste des Fiches de Cours -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="coursesGrid">
            
            <!-- Carte 1 -->
            <div class="course-card bg-slate-800 border border-slate-700 rounded-xl p-5 flex flex-col justify-between hover:border-brand-500 transition" data-category="communication">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider bg-indigo-900/60 text-indigo-300 px-2 py-1 rounded">Communication</span>
                    <h3 class="text-lg font-bold mt-2 text-white">Introduction aux Écosystèmes Numériques</h3>
                    <p class="text-slate-400 text-sm mt-1">Comprendre l'impact des réseaux sociaux, des plateformes et de l'information en ligne sur les stratégies de com.</p>
                </div>
                <div class="mt-4 pt-4 border-t border-slate-700/60 flex justify-between items-center">
                    <span class="text-xs text-slate-500">5 min de lecture</span>
                    <button class="text-xs bg-slate-700 hover:bg-brand-600 text-white px-3 py-1.5 rounded-lg transition" onclick="alert('Ouverture de la fiche de cours...')">Lire le cours</button>
                </div>
            </div>

            <!-- Carte 2 -->
            <div class="course-card bg-slate-800 border border-slate-700 rounded-xl p-5 flex flex-col justify-between hover:border-brand-500 transition" data-category="journalisme">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider bg-amber-900/60 text-amber-300 px-2 py-1 rounded">Journalisme</span>
                    <h3 class="text-lg font-bold mt-2 text-white">Techniques d'Interview & Reportage</h3>
                    <p class="text-slate-400 text-sm mt-1">Les règles fondamentales pour préparer un entretien, poser les bonnes questions et vérifier ses sources.</p>
                </div>
                <div class="mt-4 pt-4 border-t border-slate-700/60 flex justify-between items-center">
                    <span class="text-xs text-slate-500">8 min de lecture</span>
                    <button class="text-xs bg-slate-700 hover:bg-brand-600 text-white px-3 py-1.5 rounded-lg transition" onclick="alert('Ouverture de la fiche de cours...')">Lire le cours</button>
                </div>
            </div>

            <!-- Carte 3 -->
            <div class="course-card bg-slate-800 border border-slate-700 rounded-xl p-5 flex flex-col justify-between hover:border-brand-500 transition" data-category="methodo">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider bg-emerald-900/60 text-emerald-300 px-2 py-1 rounded">Méthodologie</span>
                    <h3 class="text-lg font-bold mt-2 text-white">Rédaction Administrative & Professionnelle</h3>
                    <p class="text-slate-400 text-sm mt-1">Maîtriser la structure des notes de service, des communiqués de presse et des rapports de stage.</p>
                </div>
                <div class="mt-4 pt-4 border-t border-slate-700/60 flex justify-between items-center">
                    <span class="text-xs text-slate-500">6 min de lecture</span>
                    <button class="text-xs bg-slate-700 hover:bg-brand-600 text-white px-3 py-1.5 rounded-lg transition" onclick="alert('Ouverture de la fiche de cours...')">Lire le cours</button>
                </div>
            </div>

        </div>
    </main>

    <!-- Pied de page -->
    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-500">
        StudyGN - Développé pour les étudiants en Communication et Journalisme.
    </footer>

    <!-- Script de filtrage simple -->
    <script>
        function filterCourses(category) {
            const cards = document.querySelectorAll('.course-card');
            cards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Recherche en temps réel
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            const cards = document.querySelectorAll('.course-card');
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = text.includes(term) ? 'flex' : 'none';
            });
        });
    </script>
</body>
</html>
